# ==========================================================
# APEX-Commerce Environment Variables (TEMPLATE)
# Copy this file to ".env" and fill in your real values.
# ==========================================================

# --- Razorpay TEST MODE keys ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_custom_webhook_secret_here

# --- Google Gemini (AI Studio) ---
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Neon PostgreSQL connection string ---
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# --- Upstash Redis (we'll use this in a later phase) ---
UPSTASH_REDIS_URL=rediss://default:xxxxxxxx@xxxx.upstash.io:6379

# --- App-wide policy defaults (money-safety) ---
STEP_UP_APPROVAL_THRESHOLD=2000
DEFAULT_MIN_MARGIN_PERCENTAGE=15

GEMINI_MODEL=gemini-2.5-flash
MAX_AGENT_DISCOUNT_PERCENTAGE=10